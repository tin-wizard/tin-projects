DOCKER_NAME=tin-production
TIN_VERSION=pc-9360df1-tin.1

HOST_ADDRESS=projects.tin.info
SECURE=true
HTTP_BIND=127.0.0.1
# Add ",mail" and set MAIL_URL=http://mail:8097 once the SMTP settings below are filled in.
COMPOSE_PROFILES=https

MAIL_URL=
MAIL_SOURCE=REPLACE_ME@tin.info
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
# SMTP_USERNAME / SMTP_PASSWORD go in secrets.production.env

# Hetzner CPX22 (4 GB). Remove both lines after rescaling to 8 GB or more.
ES_HEAP=512m
REDPANDA_MEM=1g

# Internal team: create accounts, then set to true to stop open sign-up.
DISABLE_SIGNUP=false
