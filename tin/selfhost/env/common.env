# Shared by staging and production. Per-environment values live in <env>.env,
# secrets in secrets.<env>.env (generated by `./tin.sh <env> init-secrets`, never committed).

# Upstream (Platform Collective) release for images we do not build (kvs, print; both off by default). Our images are built from tin/main (upstream develop + TIN branding).
HULY_VERSION=s0.7.428
DESKTOP_CHANNEL=0.7.426
TIN_REGISTRY=ghcr.io/tin-wizard

CR_DATABASE=defaultdb
CR_USERNAME=selfhost
REDPANDA_ADMIN_USER=superadmin

HTTP_PORT=8087
