{
  "name": "@hcengineering/pod-mcp",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "TIN",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true",
    "docker:build": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_build.sh platformcollective/mcp",
    "docker:tbuild": "docker build -t platformcollective/mcp . --platform=linux/amd64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/mcp",
    "docker:abuild": "docker build -t platformcollective/mcp . --platform=linux/arm64 && node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag_push.sh platformcollective/mcp",
    "docker:staging": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/mcp staging",
    "docker:push": "node ../../../common/scripts/bash.js ../../../common/scripts/docker_tag.sh platformcollective/mcp",
    "run-local": "cross-env ts-node src/index.ts",
    "format": "format src",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "@tsconfig/node16": "^1.0.4",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "cross-env": "~7.0.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "@types/jest": "^30.0.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-config-love": "^157.0.0"
  },
  "dependencies": {
    "@hcengineering/server-token": "workspace:^0.7.18",
    "@hcengineering/api-client": "workspace:^0.7.25",
    "@hcengineering/core": "workspace:^0.7.26",
    "@hcengineering/chunter": "workspace:^0.7.0",
    "@hcengineering/contact": "workspace:^0.7.0",
    "@hcengineering/document": "workspace:^0.7.0",
    "@hcengineering/rank": "workspace:^0.7.18",
    "@hcengineering/task": "workspace:^0.7.0",
    "@hcengineering/text": "workspace:^0.7.19",
    "@hcengineering/text-markdown": "workspace:^0.7.21",
    "@hcengineering/tracker": "workspace:^0.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.5.4"
  },
  "license": "EPL-2.0"
}
